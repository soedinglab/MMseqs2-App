ARG FRONTEND_APP
ARG GPU=
ARG downloader=${FRONTEND_APP}${GPU}_${TARGETARCH}_downloader

FROM scratch AS mmseqs_amd64_downloader
WORKDIR /opt/build
ONBUILD ADD https://mmseqs.com/latest/mmseqs-linux-avx2.tar.gz  .
ONBUILD ADD https://mmseqs.com/latest/mmseqs-linux-sse41.tar.gz .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-avx2.tar.gz  .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-sse41.tar.gz .

FROM scratch AS mmseqs_arm64_downloader
WORKDIR /opt/build
ONBUILD ADD https://mmseqs.com/latest/mmseqs-linux-arm64.tar.gz  .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-arm64.tar.gz  .

FROM scratch AS mmseqs_gpu_amd64_downloader
WORKDIR /opt/build
ONBUILD ADD https://mmseqs.com/latest/mmseqs-linux-gpu.tar.gz .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-gpu.tar.gz .

FROM scratch AS mmseqs_gpu_arm64_downloader
WORKDIR /opt/build
ONBUILD ADD https://mmseqs.com/latest/mmseqs-linux-gpu-arm64.tar.gz .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-gpu-arm64.tar.gz .

FROM scratch AS foldseek_amd64_downloader
WORKDIR /opt/build
ARG FOLDSEEK_HASH=foldseek
ONBUILD ADD https://mmseqs.com/${FOLDSEEK_HASH}/foldseek-linux-avx2.tar.gz  .
ONBUILD ADD https://mmseqs.com/${FOLDSEEK_HASH}/foldseek-linux-sse41.tar.gz .
ARG FOLDMASON_HASH=foldmason
ONBUILD ADD https://mmseqs.com/${FOLDMASON_HASH}/foldmason-linux-avx2.tar.gz .
ONBUILD ADD https://mmseqs.com/${FOLDMASON_HASH}/foldmason-linux-sse41.tar.gz .
ARG FOLDDISCO_HASH=folddisco
# ARG FOLDDISCO_HASH=archive/7514114fb6c444c0483e20838a0a06688304918e
ONBUILD ADD https://mmseqs.com/${FOLDDISCO_HASH}/folddisco-linux-x86_64.tar.gz .
ONBUILD ADD https://mmseqs.com/foldcomp/foldcomp-linux-x86_64.tar.gz .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-avx2.tar.gz  .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-sse41.tar.gz .

FROM scratch AS foldseek_arm64_downloader
WORKDIR /opt/build
ARG FOLDSEEK_HASH=foldseek
ONBUILD ADD https://mmseqs.com/${FOLDSEEK_HASH}/foldseek-linux-arm64.tar.gz  .
ARG FOLDMASON_HASH=foldmason
ONBUILD ADD https://mmseqs.com/${FOLDMASON_HASH}/foldmason-linux-arm64.tar.gz .
ARG FOLDDISCO_HASH=folddisco
# ARG FOLDDISCO_HASH=archive/de0174aee028b8fb774d865cab882c8829afb69a
ONBUILD ADD https://mmseqs.com/${FOLDDISCO_HASH}/folddisco-linux-arm64.tar.gz .
ONBUILD ADD https://mmseqs.com/foldcomp/foldcomp-linux-arm64.tar.gz .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-arm64.tar.gz .

FROM scratch AS foldseek_gpu_amd64_downloader
WORKDIR /opt/build
ARG FOLDSEEK_HASH=foldseek
ONBUILD ADD https://mmseqs.com/${FOLDSEEK_HASH}/foldseek-linux-gpu.tar.gz .
ARG FOLDMASON_HASH=foldmason
ONBUILD ADD https://mmseqs.com/${FOLDMASON_HASH}/foldmason-linux-avx2.tar.gz .
ONBUILD ADD https://mmseqs.com/${FOLDMASON_HASH}/foldmason-linux-sse41.tar.gz .
ARG FOLDDISCO_HASH=folddisco
ONBUILD ADD https://mmseqs.com/${FOLDDISCO_HASH}/folddisco-linux-x86_64.tar.gz .
ONBUILD ADD https://mmseqs.com/foldcomp/foldcomp-linux-x86_64.tar.gz .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-gpu.tar.gz .

FROM scratch AS foldseek_gpu_arm64_downloader
WORKDIR /opt/build
ARG FOLDSEEK_HASH=foldseek
ONBUILD ADD https://mmseqs.com/${FOLDSEEK_HASH}/foldseek-linux-gpu-arm64.tar.gz .
ARG FOLDMASON_HASH=foldmason
ONBUILD ADD https://mmseqs.com/${FOLDMASON_HASH}/foldmason-linux-arm64.tar.gz .
ARG FOLDDISCO_HASH=folddisco
ONBUILD ADD https://mmseqs.com/${FOLDDISCO_HASH}/folddisco-linux-arm64.tar.gz .
ONBUILD ADD https://mmseqs.com/foldcomp/foldcomp-linux-arm64.tar.gz .
ONBUILD ADD https://mmseqs.com/riboseek/riboseek-linux-gpu-arm64.tar.gz .

FROM $downloader AS downloader

# Build gfaidx from a pinned source revision on Docker's target platform. This
# keeps the existing multi-architecture backend images usable on amd64 and arm64.
FROM debian:stable-slim AS gfaidx-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake wget zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# This published commit reports version 1.9.7 and contains the query threading
# and haplotype-gap options accepted by the backend API.
ARG GFAIDX_REF=1e4bfee8f33af5bac33ef7dec61f01cef7017484
ARG GFAIDX_SHA256=7619b703f7b21a80a92da09e161acbe116fb04c9fc9193026ce35180c2fa1929
RUN wget -q -O /tmp/gfaidx.tar.gz \
    "https://github.com/fawaz-dabbaghieh/gfaidx/archive/${GFAIDX_REF}.tar.gz" \
    && echo "$GFAIDX_SHA256  /tmp/gfaidx.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/build/gfaidx-source \
    && tar -xzf /tmp/gfaidx.tar.gz --strip-components=1 -C /opt/build/gfaidx-source
RUN cmake -S /opt/build/gfaidx-source -B /opt/build/gfaidx-build \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && cmake --build /opt/build/gfaidx-build --parallel \
    && cmake --install /opt/build/gfaidx-build --prefix /opt/gfaidx

FROM --platform=$BUILDPLATFORM golang:latest AS builder
ARG TARGETARCH
ARG FRONTEND_APP

WORKDIR /opt/build
ADD backend .
RUN GOOS=linux GOARCH=$TARGETARCH go build -o mmseqs-web

ADD https://raw.githubusercontent.com/soedinglab/MMseqs2/678c82ac44f1178bf9a3d49bfab9d7eed3f17fbc/util/mmseqs_wrapper.sh wrappers/mmseqs
ADD https://raw.githubusercontent.com/steineggerlab/foldseek/2a7d682841e78deb511ada92fa5caa1f8f183f14/util/foldseek_wrapper.sh wrappers/foldseek

COPY --from=downloader /opt/build/* .
RUN mkdir -p binaries; \
    if [ "$TARGETARCH" = "arm64" ]; then \
      for i in mmseqs riboseek foldseek foldmason folddisco foldcomp; do \
        for j in arm64 gpu-arm64; do \
          if [ -e "${i}-linux-${j}.tar.gz" ]; then \
            cat ${i}-linux-${j}.tar.gz | tar -xzvf- ${i}/bin/${i}; \
            if [ "$i" = "foldcomp" ] ; then \
              cat ${i}-linux-${j}.tar.gz | tar -xzvf- ${i}; \
              mv -f -- ${i} binaries/${i}; \
            else \
              mv -f -- ${i}/bin/${i} binaries/${i}; \
            fi; \
          fi; \
        done; \
      done; \
    else \
      for i in mmseqs riboseek foldseek foldmason folddisco foldcomp; do \
        for j in sse41 avx2 x86_64 gpu; do \
          if [ -e "${i}-linux-${j}.tar.gz" ]; then \
            cat ${i}-linux-${j}.tar.gz | tar -xzvf- ${i}/bin/${i}; \
            if [ "$i" = "folddisco" ] ; then \
              mv -f -- ${i}/bin/${i} binaries/${i}; \
            elif [ "$i" = "foldcomp" ]; then \
              cat ${i}-linux-${j}.tar.gz | tar -xzvf- ${i}; \
              mv -f -- ${i} binaries/${i}; \
            elif [ "$j" = "gpu" ]; then \
              mv -f -- ${i}/bin/${i} binaries/${i}; \
            else \
              mv -f -- ${i}/bin/${i} binaries/${i}_${j}; \
            fi; \
          fi; \
        done; \
      done; \
      for i in mmseqs foldseek; do \
        if [ -e "binaries/${i}_avx2" ]; then \
          sed "s|${i}_sse2|${i}_sse41|" wrappers/${i} > binaries/${i}; \
        fi; \
      done; \
      if [ -e binaries/foldmason_avx2 ]; then \
        sed 's|foldseek|foldmason|g' wrappers/foldseek > binaries/foldmason; \
      fi; \
      if [ -e binaries/riboseek_avx2 ]; then \
        sed -e 's|mmseqs|riboseek|g' -e 's|riboseek_sse2|riboseek_sse41|' wrappers/mmseqs > binaries/riboseek; \
      fi; \
    fi; \
    chmod -R +x binaries; \
    ls -l binaries;

FROM debian:stable-slim
LABEL maintainer="Milot Mirdita <milot@mirdita.de>"

RUN apt-get update && apt-get install -y ca-certificates wget aria2 libstdc++6 zlib1g && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/build/mmseqs-web /opt/build/binaries/* /usr/local/bin/
COPY --from=gfaidx-builder /opt/gfaidx/bin/gfaidx /usr/local/bin/gfaidx
COPY --from=gfaidx-builder /opt/build/gfaidx-source/LICENSE /usr/share/doc/gfaidx/LICENSE

# Fail the image build immediately if the copied binary or runtime libraries
# are unusable on the selected target architecture.
RUN /usr/local/bin/gfaidx --version

ENTRYPOINT ["/usr/local/bin/mmseqs-web"]
